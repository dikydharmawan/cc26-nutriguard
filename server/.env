# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nutriguard"

# JWT
JWT_SECRET="super_access_secret"
JWT_REFRESH_SECRET="super_refresh_secret"
JWT_ACCESS_TTL="15m"
