# Server
PORT=3000
NODE_ENV=development

# ML
USE_STUB_PREDICTOR=true          # false = load real TF model from TF_MODEL_PATH
TF_MODEL_PATH="ml/saved_model"   # directory containing model.json or SavedModel

# S3 (i don't have an aws account so i cant test it)
AWS_BUCKET=""
AWS_REGION="us-east-1"
